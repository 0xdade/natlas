# Copy this file to agent/.env and fill in the values.
# agent/.env is gitignored and must never be committed.

# Agent credentials from the Django admin (Agents → generate token).
# Format: <agent_uuid>:<raw_token>
NATLAS_AGENT_TOKEN=

# Set to 1 to use masscan for port discovery before nmap fingerprinting.
# Requires CAP_NET_RAW. Defaults to 0 (nmap only).
# NATLAS_USE_MASSCAN=1

# Set to 1 to enable DEBUG logging (logs full command, stderr, file sizes).
# NATLAS_DEBUG=1
